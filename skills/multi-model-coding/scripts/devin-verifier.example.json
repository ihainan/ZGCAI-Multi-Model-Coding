{
  "version": 1,
  "permissions": {
    "allow": [
      "Edit(/path/to/blind-copy-for-this-verifier/**)",
      "Write(/path/to/blind-copy-for-this-verifier/**)",
      "Write(/path/to/build-cache/**)",
      "Write(/path/to/build-tmp/**)",
      "Write(/path/to/package-cache/**)",
      "Write(/path/to/verifier-tmpdir/**)"
    ],
    "deny": [
      "web_search",
      "run_subagent",
      "Read(/home/USER/.ssh/**)",
      "Read(/home/USER/.kube/**)",
      "Read(/home/USER/.codex/**)",
      "Read(/home/USER/.claude/**)",
      "Read(/home/USER/.config/gh/**)",
      "Read(/home/USER/.config/devin/credentials.toml)",
      "Read(/home/USER/.local/share/devin/credentials.toml)",
      "Read(/path/to/review-materials-except-the-findings-file/**)",
      "Read(/path/to/other-project-dirs/**)",
      "Read(/path/to/other-blind-copies/**)",
      "Read(/path/to/the-implementer-worktrees/**)",
      "Read(/path/to/blind-copy-for-this-verifier/docs/spec-sources/**)"
    ]
  }
}
